# ----------------------------------------------------------------------------
# MOSES - Umgebungsvariablen
# Alle Werte auf einen Schlag erzeugen:  npm run steintafel
# Lokal in eine Datei .env.local kopieren (die ist per .gitignore ausgeschlossen).
# ----------------------------------------------------------------------------

# Losungswort als scrypt-Hash. PFLICHT - ohne kommt niemand hinein.
MOSES_PASSWORT_HASH="scrypt:16384:8:1:...:..."

# Nur fuer den Notfall/Erstversuch: Passwort im Klartext.
# Die App warnt sichtbar, solange dieser Weg benutzt wird. Bitte nicht produktiv.
# MOSES_PASSWORT="bitte-durch-den-hash-ersetzen"

# Signiert das Sitzungs-Cookie. PFLICHT, mindestens 32 Zeichen.
MOSES_SESSION_SECRET="..."

# Salz fuer den IP-Hash der Login-Wache (optional; sonst wird das Session-Secret genutzt).
MOSES_IP_SALZ="..."

# Schuetzt den taeglichen Cron-Endpunkt /api/sabbat. PFLICHT in Produktion.
# Vercel setzt diesen Wert automatisch als "Authorization: Bearer ..." ein.
CRON_SECRET="..."

# Datenbank. Bei Vercel Postgres / Neon wird POSTGRES_URL automatisch gesetzt.
# Ohne diese Variable laeuft die App im fluechtigen Wuestenspeicher (nur zum Ausprobieren).
POSTGRES_URL="postgres://benutzer:passwort@host/datenbank?sslmode=require"
